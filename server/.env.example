# Copy to server/.env and fill in. server/.env is git-ignored; never commit real values.

NODE_ENV=development
PORT=5001
# Local MongoDB or an Atlas URI (mongodb+srv://...). Docker Compose overrides this
# with its own mongo container unless COMPOSE_MONGO_URI is set.
MONGO_URI=mongodb://127.0.0.1:27017/tokengate
# At least 32 characters. Generate one with: openssl rand -hex 32
JWT_SECRET=replace-me-with-a-long-random-string-of-32-chars
JWT_EXPIRES_IN=12h
# Origin allowed by CORS (the dashboard).
CLIENT_URL=http://localhost:5173
LOG_LEVEL=info
# Prompts and completions are never logged unless this is true.
LOG_PROMPTS=false
