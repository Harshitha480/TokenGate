# Copy to server/.env and fill in. server/.env is git-ignored; never commit real values.

NODE_ENV=development
PORT=5001
# Local MongoDB or an Atlas URI (mongodb+srv://...). Docker Compose overrides this
# with its own mongo container unless COMPOSE_MONGO_URI is set.
MONGO_URI=mongodb://127.0.0.1:27017/tokengate
# At least 32 characters. Generate one with: openssl rand -hex 32
JWT_SECRET=replace-me-with-a-long-random-string-of-32-chars
JWT_EXPIRES_IN=12h
# Origin allowed by CORS (the dashboard).
CLIENT_URL=http://localhost:5173
LOG_LEVEL=info
# Prompts and completions are never logged unless this is true.
LOG_PROMPTS=false
# bcrypt cost factor for dashboard passwords.
BCRYPT_ROUNDS=12
# Requests per minute for a gateway key that has no custom limit.
DEFAULT_RATE_LIMIT_PER_MINUTE=20

# Providers. Leave a key empty to disable that provider; its models then fail over.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Per-attempt provider timeout; models.js can override it per model.
PROVIDER_TIMEOUT_MS=30000

# Exact-match response cache: "mongo" (TTL collection) or "upstash" (Redis).
CACHE_DRIVER=mongo
CACHE_TTL_SECONDS=3600
# Rate limit state: "memory" (single instance) or "upstash" (shared across instances).
RATE_LIMIT_DRIVER=memory
# Login/register attempts per minute per IP.
AUTH_RATE_LIMIT_PER_MINUTE=10
# Required only when a driver above is "upstash".
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Lets clients send X-TokenGate-Simulate-Failure: primary to demo fallback.
ALLOW_FAILURE_SIMULATION=true
# Number of reverse proxies in front of the API (so rate limits see the real client IP).
TRUST_PROXY=0
